RAPIDAPI_KEY=your_rapidapi_key_here

# --- API server (src/server.js) ---

# Whether the server automatically kicks off a background pipeline run on
# boot (subject to the staleness guard below). "true" or "false".
FETCH_ON_START=true

# Minimum age (in hours) of the most recent job activity in the DB before a
# startup fetch is allowed to run. If the DB is empty, the guard is skipped
# and a fetch always runs. Prevents burning API quota on every restart.
FETCH_MIN_INTERVAL_HOURS=6
